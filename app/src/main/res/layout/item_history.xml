<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Thêm hình ảnh ở đây nếu cần -->
         <ImageView
             android:id="@+id/imgHistoryView"
             android:layout_width="80dp"
             android:layout_height="80dp"
             android:src="@drawable/logo"
             android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <!-- Tên Tour -->
            <TextView
                android:id="@+id/tourName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tour Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Giá Tour -->
            <TextView
                android:id="@+id/tourPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tour Price"
                android:textSize="16sp"
                android:textColor="#FF5722"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Mô tả Tour -->
            <TextView
                android:id="@+id/tourDes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tour Description"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Ngày Tour -->
            <TextView
                android:id="@+id/tourDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tour Date"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
